<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox fx:id="detailContainer" alignment="TOP_CENTER" prefHeight="300.0" prefWidth="380.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.ControllerItemDetail">
   <children>
      <ImageView fx:id="imageGame" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </ImageView>
      <Label fx:id="labelDetailName" text="Nombre" textAlignment="CENTER" wrapText="true">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <VBox.margin>
            <Insets bottom="5.0" top="10.0" />
         </VBox.margin>
      </Label>
      <Label fx:id="labelDetailPlot" text="Trama del joc..." textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="13.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" top="5.0" />
         </VBox.margin>
       </Label>
       <Circle fx:id="colorCircle" radius="6.0" stroke="TRANSPARENT" strokeType="INSIDE">
          <VBox.margin>
             <Insets top="10.0" />
          </VBox.margin>
       </Circle>
    </children>
</VBox>
